{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json","name":"4cc1d3fb4d4c3d8c2cd4","position":{"x":0,"y":280.19138755980862,"z":5000,"height":439.4258373205742,"width":1280,"tabOrder":5000},"visual":{"visualType":"textbox","objects":{"general":[{"properties":{"paragraphs":[{"textRuns":[{"value":"💼 Business Recommendations","textStyle":{"fontWeight":"bold","fontSize":"16pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":""}]},{"textRuns":[{"value":"1. 🚫 Restrict Grade E, F, G Lending","textStyle":{"fontWeight":"bold","fontSize":"14pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":"   Grade G defaults at 49.50% — nearly 8.3x higher than Grade A (5.97%).","textStyle":{"fontSize":"12pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":"   Grades E-G represent 10% of portfolio but contribute 20.5% of all defaults.","textStyle":{"fontSize":"12pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":"   Recommendation: Cap Grade E-F issuance and eliminate Grade G loans entirely.","textStyle":{"fontSize":"12pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":""}]},{"textRuns":[{"value":"2. ⚠ Enforce DTI Cap at 25%","textStyle":{"fontWeight":"bold","fontSize":"14pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":"   Borrowers with DTI above 25 default at 26.64% vs 14.66% for DTI below 10 — a 1.82x multiplier.","textStyle":{"fontSize":"12pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":"   Recommendation: Reject or require collateral for all applications with DTI above 25.","textStyle":{"fontSize":"12pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":""}]},{"textRuns":[{"value":"3. 🏦 Flag Small Business Loans for Enhanced Scrutiny","textStyle":{"fontWeight":"bold","fontSize":"14pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":"   Small Business loans carry the highest default rate at 29.43%.","textStyle":{"fontSize":"12pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":"   Recommendation: Require business plan verification and stronger income proof before approval.","textStyle":{"fontSize":"12pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":""}]},{"textRuns":[{"value":"4. 📊 Monitor Low Income + High DTI Segment","textStyle":{"fontWeight":"bold","fontSize":"14pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":"   Low income borrowers with DTI 25+ default at 28.03% — the most vulnerable segment.","textStyle":{"fontSize":"12pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"},{"textRuns":[{"value":"   Recommendation: Introduce income-based lending limits and mandatory financial counselling.","textStyle":{"fontSize":"12pt","color":"#ffffff"}}],"horizontalTextAlignment":"center"}]}}]},"visualContainerObjects":{"background":[{"properties":{"show":{"expr":{"Literal":{"Value":"false"}}}}}]},"drillFilterOtherVisuals":true}}