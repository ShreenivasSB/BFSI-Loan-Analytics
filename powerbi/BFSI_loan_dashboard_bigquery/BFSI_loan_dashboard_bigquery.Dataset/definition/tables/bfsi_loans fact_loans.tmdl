table 'bfsi_loans fact_loans'

	measure 'Default Rate %' =
			
			DIVIDE(
			    SUM('bfsi_loans fact_loans'[loan_outcome]),
			    COUNT('bfsi_loans fact_loans'[loan_id]),
			    0
			) * 100

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Loans' =
			
			COUNT('bfsi_loans fact_loans'[loan_id])
		formatString: 0

	measure 'Total Defaults' =
			
			SUM('bfsi_loans fact_loans'[loan_outcome])
		formatString: #,0

	measure 'Total Loan Amount' =
			
			FORMAT(SUM('bfsi_loans fact_loans'[loan_amnt]), "#,##0")

	column loan_id
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: loan_id

		annotation SummarizationSetBy = Automatic

	column grade_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: grade_id

		annotation SummarizationSetBy = Automatic

	column purpose_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: purpose_id

		annotation SummarizationSetBy = Automatic

	column income_band_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: income_band_id

		annotation SummarizationSetBy = Automatic

	column dti_band_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: dti_band_id

		annotation SummarizationSetBy = Automatic

	column risk_tier_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: risk_tier_id

		annotation SummarizationSetBy = Automatic

	column loan_amnt
		dataType: double
		summarizeBy: sum
		sourceColumn: loan_amnt

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column int_rate
		dataType: double
		summarizeBy: sum
		sourceColumn: int_rate

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column annual_inc
		dataType: double
		summarizeBy: sum
		sourceColumn: annual_inc

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column dti
		dataType: double
		summarizeBy: sum
		sourceColumn: dti

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column loan_outcome
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: loan_outcome

		annotation SummarizationSetBy = Automatic

	column issue_year
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: issue_year

		annotation SummarizationSetBy = Automatic

	partition 'bfsi_loans fact_loans' = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject="bfsi-loan-analytics"]),
				    bfsi_loans_fact_loans = Source{[Name="bfsi_loans"]}[Data]{[Name="fact_loans"]}[Data]
				in
				    bfsi_loans_fact_loans

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

