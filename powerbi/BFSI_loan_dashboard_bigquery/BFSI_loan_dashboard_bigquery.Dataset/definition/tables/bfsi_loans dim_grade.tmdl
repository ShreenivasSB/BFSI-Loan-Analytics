table 'bfsi_loans dim_grade'

	column grade_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: grade_id

		annotation SummarizationSetBy = Automatic

	column grade
		dataType: string
		summarizeBy: none
		sourceColumn: grade

		annotation SummarizationSetBy = Automatic

	partition 'bfsi_loans dim_grade' = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject="bfsi-loan-analytics"]),
				    bfsi_loans_dim_grade = Source{[Name="bfsi_loans"]}[Data]{[Name="dim_grade"]}[Data]
				in
				    bfsi_loans_dim_grade

	annotation PBI_ResultType = Table

